{
  "name": "between-bells",
  "private": true,
  "version": "1.0.0",
  "description": "Every passing period, timed for the way you move. Built by Rishik Rontala for the CSC Back-to-School Hackathon.",
  "author": "Rishik Rontala",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
